# Port configuration (default: 8080)
PORT=8080

# Logging level: trace, debug, info, warn, error (default: info)
RUST_LOG=info

# Directory (or single JSON file) mock definitions are read from.
# Unset, Mimic uses /app/mocks when it exists — that's the Docker image, whose
# volume mount creates it — and ./mocks otherwise, which is what a local
# `cargo run` or an installed binary picks up. Subdirectories are searched too.
# MIMIC_MOCKS_DIR=./mocks

# Routes Mimic answers itself, which a mock therefore cannot serve.
# Set MIMIC_HEALTH_PATH to an empty value to stop serving the health check and
# free GET /health for a mock; set it to another path to move it. Likewise
# MIMIC_ADMIN_PREFIX moves the admin API, and MIMIC_DISABLE_ADMIN=true removes
# it. Defaults reserve GET /health and the /admin/* endpoints.
# MIMIC_HEALTH_PATH=/health
# MIMIC_ADMIN_PREFIX=/admin
# MIMIC_DISABLE_ADMIN=false

# Bearer token the admin API requires. Unset leaves /admin/* open, which is how
# every Mimic has always behaved. /health stays open either way, since liveness
# probes carry no credentials.
# MIMIC_ADMIN_TOKEN=

# Body field names whose values the request log replaces with [REDACTED],
# comma-separated and case-insensitive. Applies to JSON (including nested
# objects and arrays) and urlencoded form bodies, in both the recorded request
# and the recorded response — never in what the client receives or what
# matching runs against. An explicit list replaces the default entirely; an
# empty value stores bodies verbatim.
# Default: password,passwd,token,access_token,refresh_token,id_token,secret,
#          client_secret,api_key,apikey,private_key,authorization
# MIMIC_REDACT_BODY_FIELDS=password,token,secret,api_key

# Keep no request/response bodies in the log at all.
# MIMIC_DISABLE_BODY_LOG=false
# Maximum request body size Mimic will buffer, in bytes (default: 10485760 = 10 MB)
# Requests over this size are rejected with 413 Payload Too Large before the
# body is buffered.
MIMIC_MAX_BODY_SIZE=10485760

# ---------------------------------------------------------------------------
# CORS
#
# Off by default: with MIMIC_CORS unset, no response gains a header and an
# OPTIONS request still 404s, exactly as before. Switch it on and a browser app
# can call a Mimic-backed API without a single extra mock file — preflights are
# answered automatically for any path that has a mock behind it.
#
# A mock's own Access-Control-* response_headers always win over these, so
# mocking a CORS *failure* stays possible.
# ---------------------------------------------------------------------------

# Master switch (default: false)
MIMIC_CORS=false

# Allowed origins: * or a comma-separated allowlist (default: *)
# An origin that isn't listed receives no Access-Control-Allow-Origin at all.
MIMIC_CORS_ORIGINS=*

# Methods advertised on a preflight (default: GET,POST,PUT,PATCH,DELETE,OPTIONS)
MIMIC_CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

# Allowed request headers: * reflects whatever the preflight asked for
# (default: *)
MIMIC_CORS_HEADERS=*

# Send Access-Control-Allow-Credentials (default: false). Invalid with
# MIMIC_CORS_ORIGINS=* per the CORS spec — Mimic then reflects the request
# origin instead and warns at startup.
MIMIC_CORS_CREDENTIALS=false

# How long a browser may cache a preflight, in seconds (default: 600)
MIMIC_CORS_MAX_AGE=600

# ---------------------------------------------------------------------------
# Proxy / Record-and-Replay
#
# Unset (the default): unmatched requests get a 404, unchanged from before.
# See "Proxy / Record-and-Replay" in the README.
# ---------------------------------------------------------------------------

# Forward an unmatched request to this upstream instead of 404ing.
# MIMIC_PROXY_UPSTREAM=https://api.example.com

# Record proxied responses as new mock files under mocks/_recorded/, so the
# next identical request is replayed from disk instead of hitting the
# network again (default: false)
# MIMIC_RECORD_UPSTREAM=true

# How long to wait for the upstream before falling back to a 404, in
# milliseconds (default: 5000)
# MIMIC_PROXY_TIMEOUT_MS=5000
