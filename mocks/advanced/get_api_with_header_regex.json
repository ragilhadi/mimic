{
  "method": "GET",
  "path": "/api/secure",
  "status": 200,
  "headers": {
    "required": {
      "x-api-key": {"regex": "^[A-Za-z0-9]{32}$"},
      "x-request-id": {"regex": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"}
    }
  },
  "response": {
    "secure_data": "This is secure content",
    "validation": "regex_pattern_matched",
    "api_key_format": "32 alphanumeric characters",
    "request_id_format": "UUID v4"
  }
}
