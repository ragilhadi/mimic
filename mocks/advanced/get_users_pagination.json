{
  "method": "GET",
  "path": "/api/users",
  "status": 200,
  "query_params": {
    "params": {
      "page": {
        "regex": "^[0-9]+$"
      },
      "limit": {
        "regex": "^(10|20|50|100)$"
      }
    },
    "strict": false
  },
  "response": {
    "users": [
      {"id": 1, "name": "Alice"},
      {"id": 2, "name": "Bob"}
    ],
    "pagination": {
      "page": 1,
      "limit": 10,
      "total": 100
    }
  }
}
