{
  "method": "POST",
  "path": "/api/exact",
  "status": 200,
  "headers": {
    "required": {
      "content-type": "application/json"
    }
  },
  "body": {
    "type": "json",
    "exact": {
      "username": "admin",
      "password": "secret",
      "remember": true
    }
  },
  "response": {
    "success": true,
    "message": "Exact JSON match - all fields must match exactly",
    "matched": "exact",
    "token": "exact_match_token_xyz"
  }
}
