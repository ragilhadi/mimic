{
  "method": "POST",
  "path": "/form/contact",
  "status": 201,
  "headers": {
    "required": {
      "content-type": "application/x-www-form-urlencoded"
    }
  },
  "body": {
    "type": "form",
    "fields": {
      "name": "John Doe",
      "email": "john@example.com",
      "message": "Hello, I need help!"
    },
    "strict": true
  },
  "response": {
    "success": true,
    "message": "Contact form submitted successfully",
    "ticket_id": "TICKET-12345",
    "estimated_response": "24 hours"
  }
}
